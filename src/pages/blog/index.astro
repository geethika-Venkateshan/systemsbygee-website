---
import Layout from '../../layouts/Layout.astro';

const title = 'Blog | Systems by Gee';
const description = 'Practical, no-fluff writing on GoHighLevel, automations, and the systems that let founders stop surviving their business and start leading it.';

const posts = [
  {
    slug: 'burned-by-tech-vas',
    title: "I've been burned by tech VAs before: here's how to find the right one",
    excerpt: "If a tech VA let you down before, it was probably not the tech. Here's what to check before you hire again: access, scope, silence, and handoff.",
    date: 'Oct 5, 2026',
    read: '5 min read',
    tag: 'Hiring Help',
    image: '/images/blog-ghl.jpg'
  },
  {
    slug: 'ai-agents-in-ghl',
    title: 'AI agents in GHL: what they can actually do for your business right now',
    excerpt: "What AI agents in GoHighLevel actually do right now: what they handle well, where they still need a human, and how to know if it's worth setting up.",
    date: 'Sep 28, 2026',
    read: '5 min read',
    tag: 'GoHighLevel',
    image: '/images/blog-ghl.jpg'
  },
  {
    slug: 'how-agencies-use-ghl-white-label',
    title: 'How agencies use GHL white label to deliver more without working more',
    excerpt: "White label GoHighLevel isn't a shortcut, it's leverage done properly. Here's what actually has to be true under the hood for it to hold up client by client.",
    date: 'Sep 21, 2026',
    read: '6 min read',
    tag: 'GoHighLevel',
    image: '/images/blog-ghl.jpg'
  },
  {
    slug: 'why-your-funnels-arent-converting',
    title: "Why your funnels aren't converting (and it's probably not the funnel)",
    excerpt: "When a funnel underperforms, the page usually isn't the problem. Here's what to check after opt-in before you touch the design again.",
    date: 'Sep 14, 2026',
    read: '5 min read',
    tag: 'Automations',
    image: '/images/hero.jpg'
  },
  {
    slug: 'what-your-business-backend-should-look-like',
    title: 'What your business backend should actually look like (and why most coaches get it wrong)',
    excerpt: 'Set up means the tools exist. Working means nothing falls through if you disappear for a week. Here is the difference, and how to check where your backend really stands.',
    date: 'Jul 31, 2026',
    read: '5 min read',
    tag: 'Systems',
    image: '/images/working.jpg'
  },
  {
    slug: 'why-your-ghl-setup-is-costing-you-clients',
    title: 'Why your GHL setup is costing you clients without you knowing it',
    excerpt: 'Your setup does not have to crash to cost you clients. Here are the 3 hidden leaks I find in almost every GHL audit, and a quick way to check for each one this week.',
    date: 'Jun 22, 2026',
    read: '5 min read',
    tag: 'GoHighLevel',
    image: '/images/blog-ghl.jpg'
  }
];

---
<Layout title={title} description={description}>

  <section class="hero">
    <div class="container">
      <h1>Systems, plainly.</h1>
      <p class="lead">No-fluff writing on GoHighLevel, automations, and the backend that lets you finally breathe.</p>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="blog-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="blog-card reveal">
            <div class="thumb" style={`background-image:url('${post.image}')`}></div>
            <div class="body">
              <span class="tag tag--emerald" style="align-self:flex-start;">{post.tag}</span>
              <h2>{post.title}</h2>
              <p>{post.excerpt}</p>
              <p class="meta">{post.date} &middot; {post.read}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>

---
import Layout from '../layouts/Layout.astro';

const title = 'Systems by Gee | GHL & Systems Strategist for Founders';
const description = 'I build the GoHighLevel systems and automations that run your business backend for you, so leads stop slipping and you finally get to breathe. Book a free audit.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Person', '@id': 'https://systemsbygee.netlify.app/#gee', name: 'Geethika Venkateshan', alternateName: 'Gee', jobTitle: 'GHL & Systems Strategist', url: 'https://systemsbygee.netlify.app', sameAs: ['https://www.threads.com/@systemsbygee', 'https://www.instagram.com/systemsbygee/', 'https://www.linkedin.com/in/geethika-12in/'] },
    { '@type': 'ProfessionalService', name: 'Systems by Gee', description: description, url: 'https://systemsbygee.netlify.app', founder: { '@id': 'https://systemsbygee.netlify.app/#gee' }, areaServed: ['United States', 'United Kingdom', 'India', 'Philippines', 'Worldwide'], knowsAbout: ['GoHighLevel', 'Business automation', 'CRM setup', 'Platform migration', 'AI agents', 'Systems strategy'], priceRange: '$$' },
    { '@type': 'FAQPage', mainEntity: [
      { '@type': 'Question', name: 'What does Systems by Gee do?', acceptedAnswer: { '@type': 'Answer', text: 'Systems by Gee builds and manages GoHighLevel systems and automations for coaches, OBMs, agencies, and service businesses, so the founder can lead instead of doing everything by hand.' } },
      { '@type': 'Question', name: 'Can I just set up GoHighLevel myself?', acceptedAnswer: { '@type': 'Answer', text: 'You can, but most DIY setups end up with funnels that have no automation behind them and calendars that do not talk to the CRM. A system is the logic that connects the features so the platform works for you.' } },
      { '@type': 'Question', name: 'Who does Gee work with?', acceptedAnswer: { '@type': 'Answer', text: 'Coaches, OBMs, agency owners, female founders, and local service businesses across the US, UK, India, and the Philippines.' } },
      { '@type': 'Question', name: 'How do I start?', acceptedAnswer: { '@type': 'Answer', text: 'Start with a free GHL audit. Gee shows you exactly what is costing you time and leads, and what to fix first. No pitch, no pressure.' } }
    ] }
  ]
};
---
<Layout title={title} description={description} jsonLd={jsonLd}>

  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="reveal">
          <span class="eyebrow">GHL &amp; Systems Strategist</span>
          <h1>Stop surviving your business. Start leading it again.</h1>
          <p class="lead">Somewhere between client work, admin, and broken automations, you stopped leading and started just keeping up. I build the GoHighLevel systems that run your backend for you, so you finally get to breathe.</p>
          <div class="hero-cta">
            <a href="#audit" class="btn btn--primary js-audit">Book a free audit</a>
            <a href="/case-studies/" class="btn btn--secondary">See client results</a>
          </div>
        </div>
        <div class="reveal">
          <div class="hero-photo" style="background-image:url('/images/hero.jpg');">
            <div class="hero-badge"><b>GHL certified</b> &middot; real builder</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>GHL builds</span><span>Automations</span><span>Migrations</span><span>AI agents</span><span>Funnels</span><span>Attendee portals</span><span>Systems strategy</span><span>GHL builds</span><span>Automations</span><span>Migrations</span><span>AI agents</span><span>Funnels</span><span>Attendee portals</span><span>Systems strategy</span>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Sound familiar?</span>
        <h2>Your business is growing, but behind the scenes it is held together with sticky notes and good intentions.</h2>
      </div>
      <div class="grid grid--3">
        <div class="card reveal"><h3>Leads slip away</h3><p>Someone enquires, you mean to follow up, life happens, and they book with whoever replied first.</p></div>
        <div class="card reveal"><h3>Manual everything</h3><p>You are doing by hand what a workflow should be doing for you, every single day.</p></div>
        <div class="card reveal"><h3>No time for you</h3><p>You started this to build something of your own, not to become its full-time admin.</p></div>
      </div>
    </div>
  </section>

  <div class="img-band reveal" style="background-image:url('/images/working.jpg');"></div>

  <section class="section section--sand">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">How I can help</span>
        <h2>Pick the level of support your business needs right now.</h2>
        <p class="lead">Everything starts with a free audit. From there, we go as far as you want.</p>
      </div>
      <div class="grid grid--3">
        <div class="card reveal"><h3>Tech On-Deck Support</h3><div class="price">from $497/mo</div><p>You have systems. You just want a pro on standby. Something breaks, you message me, I handle it.</p></div>
        <div class="card reveal"><h3>Gee, Build My Systems</h3><div class="price">from $1,500</div><p>You want it done, not DIY. I build your whole backend from scratch, wired around how your business actually works.</p></div>
        <div class="card reveal" style="border-color: var(--emerald); border-width: 2px;"><span class="pill">Most popular</span><h3 style="margin-top:12px;">Hire Me As Your Systems Expert</h3><div class="price">from $1,200/mo</div><p>The dream teammate. I am embedded in your business as your operational right hand. Nothing falls through.</p></div>
      </div>
      <div class="text-center mt-32"><a href="/services/" class="btn btn--secondary">See full services &amp; pricing</a></div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <span class="eyebrow">How I work</span>
      <h2 class="reveal" style="max-width: 22ch; margin: 12px 0 22px;">I do not tick your to-do list. I work alongside your business.</h2>
      <p class="lead reveal" style="max-width: 60ch;">A client once posted that her launch backend had broken with days to go. I replied, helped her immediately, no pitch. She hired me the same day. That is how I work: I fix what is broken, build what is missing, and I never ghost.</p>
      <div class="mt-32 reveal"><a href="/about/" class="btn btn--secondary">My story</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">In their words</span>
        <h2>Founders who stopped worrying about their backend.</h2>
      </div>
      <div class="quotes">
        <div class="quote-card"><p>"She came in and immediately fixed my funnels. I am soooooo calm going into launch."</p><cite>Lori Young, Offer Strategist</cite></div>
        <div class="quote-card"><p>"You can confidently hire her as your GHL VA. She is there to handle it."</p><cite>A virtual service provider</cite></div>
        <div class="quote-card"><p>"Huge thanks for her never ending patience and persistence."</p><cite>Lori Young, Offer X-Ray launch</cite></div>
        <div class="quote-card"><p>"I would highly recommend her. She has been a blessing for my team."</p><cite>Agency business manager</cite></div>
      </div>
      <div class="mt-32 reveal"><a href="/case-studies/" class="btn btn--secondary">Read the full case studies</a></div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="section-head reveal"><span class="eyebrow">Common questions</span><h2>Quick answers before we talk.</h2></div>
      <div class="faq-item reveal"><h3>Can I just set up GoHighLevel myself?</h3><p>You can, but most DIY setups end up with funnels that have no automation behind them and calendars that do not talk to the CRM. A system is the logic that connects the features so the platform actually works for you.</p></div>
      <div class="faq-item reveal"><h3>Who do you work with?</h3><p>Coaches, OBMs, agency owners, female founders, and local service businesses, across the US, UK, India, and the Philippines.</p></div>
      <div class="faq-item reveal"><h3>How do we start?</h3><p>With a free audit. I look under the hood and show you exactly what is costing you time and leads. No pitch, no pressure.</p></div>
    </div>
  </section>

  <section class="section">
    <div class="container text-center reveal">
      <h2 style="max-width: 18ch; margin: 0 auto 16px;">Ready to get your backend working for you?</h2>
      <p class="lead" style="margin: 0 auto 28px;">Book a free audit and let us find out what your systems are really costing you.</p>
      <a href="#audit" class="btn btn--primary js-audit">Book a free audit</a>
    </div>
  </section>

</Layout>

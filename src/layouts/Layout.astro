---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';

const { title, description, image, type, jsonLd } = Astro.props;
const li = 'https://www.linkedin.com/in/geethika-12in/';
const ig = 'https://www.instagram.com/systemsbygee/';
const th = 'https://www.threads.com/@systemsbygee';
const email = 'systemsbygee@gmail.com';
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} type={type} jsonLd={jsonLd} />
    <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
    <script src="https://assets.calendly.com/assets/external/widget.js" async></script>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a href="/" class="brand">Systems by Gee</a>
        <ul class="nav-links">
          <li><a href="/services/">Services</a></li>
          <li><a href="/case-studies/" class="hide-mobile">Case Studies</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/blog/" class="hide-mobile">Blog</a></li>
          <li><a href="#audit" class="btn btn--primary js-audit">Free audit</a></li>
        </ul>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <section class="section">
      <div class="container">
        <div class="newsletter reveal" id="stay-in-loop">
          <span class="eyebrow" style="color:#6FD3B5;">Stay in the loop</span>
          <h2 style="margin:10px 0 6px;">Systems tips, no fluff.</h2>
          <p class="lead" style="color:#C9C7C1; margin:0 auto; max-width:46ch;">Join the list for practical GHL and automation tips, plus new posts. No spam, unsubscribe anytime.</p>
          <form class="nl-form" name="newsletter" method="POST" data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="newsletter" />
            <p style="display:none;"><label>Skip this: <input name="bot-field" /></label></p>
            <input type="text" name="name" placeholder="First name" aria-label="First name" required />
            <input type="email" name="email" placeholder="Your email" aria-label="Email" required />
            <button type="submit">Join</button>
          </form>
          <p class="nl-note">You will only hear from me when it is genuinely useful.</p>
        </div>
      </div>
    </section>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div style="max-width: 340px;">
            <a href="/" class="brand">Systems by Gee</a>
            <p style="color:#C9C7C1; font-size:0.95rem;">GHL and systems strategist. I build the backend that finally lets you breathe.</p>
            <div class="socials">
              <a href={li} aria-label="LinkedIn" target="_blank" rel="noopener"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5.001A2.5 2.5 0 014.98 3.5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.4 8.65 21 11 21 14.3V21h-4v-5.9c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1V21H9z"/></svg></a>
              <a href={ig} aria-label="Instagram" target="_blank" rel="noopener"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
              <a href={th} aria-label="Threads" target="_blank" rel="noopener"><span style="font-family:var(--font-head); font-weight:600; font-size:1.1rem;">@</span></a>
              <a href={`mailto:${email}`} aria-label="Email"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></a>
            </div>
          </div>
          <ul class="footer-links">
            <li><a href="/services/">Services</a></li>
            <li><a href="/case-studies/">Case Studies</a></li>
            <li><a href="/about/">About</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="#audit" class="js-audit">Book a free audit</a></li>
          </ul>
        </div>
        <div class="footer-bottom">
          &copy; {new Date().getFullYear()} Systems by Gee. Built for coaches, founders, and service businesses worldwide.
        </div>
      </div>
    </footer>

    <script is:inline>
      // Scroll reveal
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Calendly popup on every audit button. Update CAL to your real Free Audit link.
      const CAL = 'https://calendly.com/systemsbygee/free-audit';
      document.querySelectorAll('a.js-audit, a[href*="calendly"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          if (window.Calendly) { e.preventDefault(); window.Calendly.initPopupWidget({ url: CAL }); }
        });
      });
    </script>
  </body>
</html>
